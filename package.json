{
  "name": "searchspace",
  "version": "1.0.0",
  "description": "An interactive visualization for various similarity measures.",
  "type": "module",
  "main": "js/app.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint --no-ignore js tests index.js demo0.js demo1.js demo2.js",
    "typecheck": "tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JosuaKrause/searchspace.git"
  },
  "keywords": [
    "k-nearest neighbors",
    "dot product",
    "cosine similarity",
    "euclidean distance",
    "manhattan distance",
    "visualization"
  ],
  "author": "Josua Krause",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/JosuaKrause/searchspace/issues"
  },
  "homepage": "https://github.com/JosuaKrause/searchspace#readme",
  "devDependencies": {
    "eslint": "^8.52.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-html": "^7.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.3.3"
  },
  "private": true
}
